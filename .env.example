# Shopify App Credentials
# Get these from your Shopify Partners Dashboard: https://partners.shopify.com
SHOPIFY_API_KEY=your_api_key_here
SHOPIFY_API_SECRET=your_api_secret_here

# Shopify API Configuration
SHOPIFY_API_SCOPES=write_metaobjects,read_metaobjects,write_metaobject_definitions,read_products,write_discounts,read_orders
SHOPIFY_API_VERSION=2026-01

# App URL Configuration
# CRITICAL: This must match EXACTLY with the URL configured in Shopify Partners Dashboard
# For production on Vercel: https://shopi-bundle.vercel.app
# For local development with ngrok: https://your-subdomain.ngrok.io
SHOPIFY_APP_URL=https://shopi-bundle.vercel.app

# Database Configuration (Neon PostgreSQL)
# Pooled connection (for serverless functions via PgBouncer)
# Use the -pooler hostname from your Neon dashboard
DATABASE_URL=postgresql://neondb_owner:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Direct connection (for Prisma migrations and schema pushes)
# Use the non-pooler hostname from your Neon dashboard
DIRECT_DATABASE_URL=postgresql://neondb_owner:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# Encryption
# Random string for encrypting sensitive data (session tokens)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_STRING=your_random_encryption_string_here

# Vercel Cron Secret
# Used to authenticate Vercel Cron job requests
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=your_cron_secret_here

# Environment
NODE_ENV=production

# IMPORTANT NOTES:
# 1. SHOPIFY_APP_URL must match the "App URL" in Partners Dashboard exactly
# 2. In Partners Dashboard, set:
#    - App URL: https://shopi-bundle.vercel.app
#    - Allowed redirection URL(s): https://shopi-bundle.vercel.app/api/auth/callback
# 3. For Neon database:
#    - DATABASE_URL uses the -pooler connection (PgBouncer, for serverless)
#    - DIRECT_DATABASE_URL uses the direct connection (for migrations)
# 4. Set CRON_SECRET in Vercel Environment Variables for monthly revenue reset
# 5. Never commit the actual .env file with real credentials
