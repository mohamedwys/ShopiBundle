{
  "name": "bundle-discount",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "shopify-function build"
  },
  "dependencies": {
    "@shopify/shopify_function": "~2.0.0"
  },
  "devDependencies": {
    "typescript": "^5.6.2"
  },
  "codegen": {
    "overwrite": true,
    "schema": "./schema.graphql",
    "documents": ["./src/**/*.graphql"],
    "generates": {
      "./src/generated/api.ts": {
        "plugins": ["typescript", "typescript-operations"]
      }
    }
  }
}
