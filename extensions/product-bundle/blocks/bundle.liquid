{% comment %}
  ShopiBundle - Product Bundle Block
  Supports two render modes:
    1. React widget (default) - Rich interactive Rapi-style experience
    2. Legacy Liquid (noscript fallback) - Server-rendered for no-JS environments

  By default, auto-inject is enabled on product pages.
  Merchants can also enter a specific bundle shortcode to display a specific bundle.
{% endcomment %}

{% assign type = 'product-bundles' %}

{% comment %} Mode 1: Specific bundle via shortcode {% endcomment %}
{% if block.settings.shortcode != blank %}
  {% assign bundle = shop.metaobjects[type][block.settings.shortcode] %}
  {% if bundle %}
    <div
      id="shopibundle-widget-{{ block.id }}"
      data-shopibundle-widget
      data-bundle-handle="{{ block.settings.shortcode }}"
      {% if product %}data-product-id="{{ product.id }}"{% endif %}
      data-shop="{{ shop.permanent_domain }}"
      data-money-format="{{ shop.money_format | json | escape }}"
      data-locale="{{ request.locale.iso_code }}"
      data-currency="{{ cart.currency.iso_code }}"
      data-proxy-path="/apps/proxy"
    >
      <noscript>
        {% assign price = 0 %}
        <div class="bundle" data-bundle-id="{{ bundle.id }}">
          <p class="bundle-title">{{ bundle.bundle_title.value }}</p>
          <p class="bundle-description">{{ bundle.description.value }}</p>
          <p class="discounted-price">{{ bundle.discount.value }}% {{ 'discount' | t }}</p>
        </div>
      </noscript>
    </div>
  {% endif %}
{% endif %}

{% comment %} Mode 2: Auto-inject - Widget discovers bundles for current product {% endcomment %}
{% if block.settings.auto_inject and product %}
  <div
    id="shopibundle-widget-auto-{{ block.id }}"
    data-shopibundle-widget
    data-product-id="{{ product.id }}"
    data-shop="{{ shop.permanent_domain }}"
    data-money-format="{{ shop.money_format | json | escape }}"
    data-locale="{{ request.locale.iso_code }}"
    data-currency="{{ cart.currency.iso_code }}"
    data-proxy-path="/apps/proxy"
  ></div>
{% endif %}

{% schema %}
{
  "name": "Product Bundle",
  "target": "section",
  "stylesheet": "style.css",
  "javascript": "bundle-widget.js",
  "templates": ["index", "product", "collection", "cart"],
  "settings": [
    {
      "type": "text",
      "id": "shortcode",
      "label": "t:label",
      "info": "t:info"
    },
    {
      "type": "checkbox",
      "id": "auto_inject",
      "label": "Auto-inject on product pages",
      "info": "Automatically show bundle offers when customer views a bundled product. Enable this for most stores.",
      "default": true
    }
  ]
}
{% endschema %}
